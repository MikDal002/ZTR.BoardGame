{
  "UpdateOptions": {
    "UpdateUrl": "https://github.com/MikDal002/ZtrBoardGame",
    "UseGitHubSource": true,
    "FetchPrereleases": true
  },
  // Adjust those settings on the production environment.
  // "BoardNetworkSettings": {
	// 	// .local is necessary for linux to resolve the hostname, adjust as needed for your network setup
  //   "PcServerAddress": "http://pcmr.local:5000",
  //   // Adjust rapsberrypi address as needed, e.g., "http://raspberrypi01:5000"
  //   "BoardAddress": "http://raspberrypi02:5000"
  // },
  "PhysicalBoardSettings": {
    "Addresses": [
      "0x20",
      "0x21",
      "0x22",
      "0x23"
    ],
    "InterruptPinNumber": 4
  },
  "urls": "http://0.0.0.0:5000",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug",
        "System": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/app.log.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "ConsoleTemplate"
    }
  }
}